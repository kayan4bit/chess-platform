NODE_ENV=development
PORT=4000

# SQLite — single file. Privacy-first. No remote DB service required.
# `file:./data/chess.db` is relative to the prisma/ directory; the real path is
# apps/backend/prisma/data/chess.db (auto-created on first run).
DATABASE_URL=file:./data/chess.db

# Optional. If unset, matchmaking uses an in-memory queue.
# REDIS_URL=redis://localhost:6379

# Generate a long random string for production!
JWT_SECRET=change-me-in-production
STOCKFISH_PATH=/usr/games/stockfish
CORS_ORIGIN=http://localhost:3000

# Auto-match solo queuers to Stockfish after this many milliseconds (0 disables).
BOT_FALLBACK_MS=15000
# Stockfish skill level (0–20) used for the bot fallback opponent.
BOT_FALLBACK_LEVEL=6
